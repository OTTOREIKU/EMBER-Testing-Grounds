 "rules": {
  "mines": [
   {
    "v": "1.04",
    "source": "FAQ M22",
    "tags": [
     "REVERSED"
    ],
    "text": "Reversed: a Mine's blast no longer catches the Flying or Aerial units in its Grid. FAQ V1.03 said it did."
   },
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.3",
    "tags": [
     "CHANGED"
    ],
    "text": "A Mine is now a small Ground Unit whose Grid counts as empty. Mines one Action places no longer set each other off, a Mine stands clear of terrain, Interception cannot target it, and it contests no Control Zone."
   },
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.9",
    "tags": [
     "NEW"
    ],
    "text": "New: blasts that go off together resolve one at a time. Each squad orders its own, and when both squads own one, the player with the initiative (this round's First Player) resolves one of theirs first, then the squads take turns. A Pholcus that jumps into a mined Grid sets its Mines off, but its own blast resolves first, and a Mine it destroyed does not go off."
   }
  ],
  "pholcus": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.9",
    "tags": [
     "CLARIFIED"
    ],
    "text": "Spelled out: the Unfolded Pholcus is a Ground Unit, so its jump sets off the Mines in the Grid it lands in, and its own blast resolves before theirs. A Mine its blast destroyed does not go off."
   }
  ],
  "white_dwarf": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 3.3",
    "tags": [
     "CLARIFIED"
    ],
    "text": "Spelled out: in Cruise Mode no hit location is determined and every hit is a Torso hit, so Cleaving's Surplus carried into it from another unit hits the Torso. Surplus that stays on it still rolls for another Part (FAQ N7)."
   }
  ],
  "command_tokens": [
   {
    "v": "1.04",
    "source": "FAQ C8, C9",
    "tags": [
     "CHANGED"
    ],
    "text": "An attacking Action's Command Coordination now comes once the attack has resolved, before the defender's own effects such as Target Tracing, and a Riposte that ends the attacker's Action Opportunity skips it."
   }
  ],
  "surplus_damage": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 4.2, 4.3",
    "tags": [
     "CLARIFIED"
    ],
    "text": "Spelled out: Cleaving's and Scatter-shot's Surplus hits a different Part, so a Part Die showing the first Part is rerolled, and ANY cannot pick it."
   }
  ],
  "tactics_cards": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.11",
    "tags": [
     "CHANGED"
    ],
    "text": "A squad's Tactics Cards are now hidden information, like the Beacons in a Beacon Pack: the other player sees each one only when it is played."
   }
  ],
  "low_value_unit": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.1.2, 1.2, 1.3, 4.1",
    "tags": [
     "CHANGED"
    ],
    "text": "No Low Value unit, a Projectile, a Deployable or a Low Value Drone, can take or block a Control Zone: one in a Zone no longer denies it. Cannot carry Hexagon Tokens is now printed as part of the tag, as FAQ J3 and M23 already ruled."
   }
  ],
  "maneuver": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.8",
    "tags": [
     "CLARIFIED"
    ],
    "text": "A full circle on the spot is a legal Maneuver: it ends facing the same way, but the unit is no longer Stationary, even with no Stationary effect to lose. A Drone's Movement command may turn a full circle too."
   }
  ],
  "detonation": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.1.3, 1.4.2",
    "tags": [
     "CHANGED"
    ],
    "text": "The Containers are Neutral Units now: a blast on all Units destroys every Container in Range, and a single-target one may leave them, so a PK3 with only a Container in Range stays."
   }
  ]
 },
 "keywords": {
  "致密装甲": [
   {
    "v": "1.021",
    "source": "GoF parts list 1.021",
    "tags": [
     "CHANGED"
    ],
    "text": "Changed from \"{Defense} may offset {Heavy Hit}\" to removing every Attack Die showing a blank face, {Lightning} or {Eye} before any Reroll."
   },
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 3.7",
    "tags": [
     "RETIRED"
    ],
    "text": "No longer a keyword: each Part that had it prints it as its own Passive Action named Dense Armor, which works only when that Part is hit. The two Armored Cores lose the keyword chip."
   }
  ],
  "冲锋X": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 3.8",
    "tags": [
     "NAME",
     "CHANGED"
    ],
    "text": "Also named Assault X. The move is up to X Grids and any unit may make it, and a destroyed Chassis stops only a Mech's move, not the Action: the old English read as if the Action needed a Chassis."
   }
  ],
  "顺劈": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 4.2",
    "tags": [
     "CLARIFIED"
    ],
    "text": "Spelled out: the Surplus hits a different Part, so a Part Die showing the first Part is rerolled, and ANY cannot pick it."
   }
  ],
  "霰射": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 4.3",
    "tags": [
     "CLARIFIED"
    ],
    "text": "Spelled out: the Surplus hits a different Part, so a Part Die showing the first Part is rerolled, and ANY cannot pick it."
   }
  ],
  "路障": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.2",
    "tags": [
     "CHANGED"
    ],
    "text": "Now the one Deployable category for the Turtle Shell, the AS3 walls and the Containers, each with a Height like Terrain. The Barricade keyword it replaces made the Turtle Shell 3-inch Terrain only while one of its allies was the target."
   }
  ],
  "机动掩体": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.2",
    "tags": [
     "CHANGED"
    ],
    "text": "The Turtle Shell is now 2-inch terrain for every unit: cover for whoever is behind it, and no block on line of sight. It had counted as 3-inch Terrain, and only while one of its allies was the target."
   }
  ],
  "墙": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.2",
    "tags": [
     "CLARIFIED"
    ],
    "text": "The AS3 walls are now Barricades, 3 inches high: they block line of sight and give Terrain Protection as before."
   }
  ],
  "设置物": [
   {
    "v": "1.04",
    "source": "Supplementary Rules 1.04, 1.1.2, 1.2, 1.3",
    "tags": [
     "CHANGED"
    ],
    "text": "A Deployable with no model is a Ground Unit, and no Deployable can capture Task Targets or interact with Control Zones: one standing in a Zone no longer contests it."
   }
