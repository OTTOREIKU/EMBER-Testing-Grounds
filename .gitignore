# Editor and tooling config, not part of the released tool.
.claude/

# Test harness output. Every `_*.ts` under app/tests is generated: the slices a
# suite writes to drive a module, and the esbuild ENTRY POINTS, which
# _combatdrive.mjs's loadCombat(name) writes with writeFileSync at the top of
# every run. There is no exception, and app/tests/.gitignore says the same thing
# closer to the files.
#
# The hand-written files under `_` are un-ignored below BY NAME: the harnesses
# the tests import (_combatdrive.mjs, the DOM shim and esbuild loader;
# _footprint.mjs; _engine.mjs; _sightref.mjs) and the AI lab's tools (see
# tools/ai-lab/README.md). Everything else under `_` is written by a run. (Of
# the two .entry.ts files once thought hand written: _combatdrive.mjs's
# loadCombat(name) rewrites them on every run.)
app/tests/_*.ts
# The bundles those entry points are built into are build artefacts too.
app/tests/_*.mjs
# Nothing deeper ignores .mjs, so the negations below are the lines that decide
# it. The DOM shim and esbuild loader:
!app/tests/_combatdrive.mjs
# The footprint reader fifteen slice harnesses prepend (types.ts baseCells):
# source, not an artefact.
!app/tests/_footprint.mjs
# The real engine, bundled and run with no page (solosetup and the computer
# seat's suites import it): source too.
!app/tests/_engine.mjs
# The reference walk of a line of sight losexact.test and turn.test check the
# engine's against (2026-10-08): source.
!app/tests/_sightref.mjs
# THE AI LAB (the code audit, 2026-10-11: the computer's measurements and every
# push's proof ran on these, and they lived on one machine only): the players and
# probes, run as `node tests/<tool>` from app/. tools/ai-lab holds the rest.
!app/tests/_squadprobe.mjs
!app/tests/_policies.mjs
!app/tests/_samegames.mjs
!app/tests/_samesmoke.mjs
!app/tests/_hudprint.mjs
!app/tests/_moveprint.mjs
!app/tests/_launchprint.mjs
!app/tests/_p7d_lib.mjs
!app/tests/_baseline.mjs
!app/tests/_squadmatch.mjs
!app/tests/_community.mjs
!app/tests/_lossprobe.mjs
!app/tests/_dronesets.mjs
!app/tests/_droneswaps.mjs
!app/tests/_stall8527.mjs
# A lab run's report.
tools/ai-lab/*.out.txt

# Cached responses from the publisher's card API (tools/sync_official.mjs).
.cache/

# Bug reports players hand over. Local only — the app saves them, nothing
# uploads them, and none of them belong in the history.
reports/
